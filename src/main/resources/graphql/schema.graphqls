type Query {
    echo(message: String!): EchoResponse!
    ping: PingResponse
}

type EchoResponse {
    original: String!
    reversed: String!
    length: Int!
    timestamp: String!
}

type PingResponse {
    status: String!
    latency: Float!
    timestamp: String!
}

# User Registration
# Input types for user registration
input RegisterUserInput {
    email: String!
    password: String!
    confirmPassword: String!
}

type Mutation {
    registerUser(input: RegisterUserInput!): String!
}