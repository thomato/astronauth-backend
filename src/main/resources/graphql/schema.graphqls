type Query {
    echo(message: String!): EchoResponse!
    ping: PingResponse
}

type EchoResponse {
    original: String!
    reversed: String!
    length: Int!
    timestamp: String!
}

type PingResponse {
    status: String!
    latency: Float!
    timestamp: String!
}

type Mutation {
    requestRegistration(input: RequestRegistrationInput!): RequestRegistrationResult!
}

input RequestRegistrationInput {
    email: String!
    password: String!
}

union RequestRegistrationResult = RegistrationRequestAccepted

type RegistrationRequestAccepted {
    message: String!
}
